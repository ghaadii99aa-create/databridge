# Copy to .env (never commit .env). Used by docker compose.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
HTTP_PORT=8080
MAX_UPLOAD_MB=50

# Public demo (see docs/DEMO_MODE.md): shared read-only sample, private per-browser uploads deleted
# after 24 hours, 10 MB / 50,000-row limits and rate limits. Leave false for a private installation.
DEMO_MODE=false
WEB_CONCURRENCY=2

# Optional AI analyst. Leave AI_PROVIDER=none to use statistical analysis only.
# AI_PROVIDER=anthropic   # or: openai
# AI_API_KEY=             # set on the server only; never in frontend code
# AI_MODEL=               # a model name available on your provider account
AI_PROVIDER=none
