# Copy to backend/.env for local development without Docker.
# With no DATABASE_URL, SQLite is used at backend/data/databridge.db (zero setup).
# DATABASE_URL=postgresql+psycopg://databridge:YOUR_PASSWORD@localhost:5432/databridge
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text
MAX_UPLOAD_MB=50
# DEMO_MODE=true   # public demo mode, see docs/DEMO_MODE.md
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=
